# Copy to .env (gitignored) and adjust for your machine.
PORT=4000

# Comma-separated. Leave unset in dev to allow any origin (Expo web on a
# random port, RN dev client on a LAN IP, etc.). In production set this to
# your real frontend origin(s).
# CORS_ORIGIN=https://teranode.app,https://admin.teranode.app
