# TerraNode web admin — Vite environment
# VITE_* vars are embedded at build time and exposed via import.meta.env

# API base URL — change to your machine's LAN IP so the web panel works
# from any device on the same network (phone, tablet, another laptop).
VITE_API_URL=http://10.59.10.242:4000

# Port the Vite dev server listens on.
PORT=5173
