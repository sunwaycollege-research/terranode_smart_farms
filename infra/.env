# Auto-loaded by `docker compose` when run from this infra/ directory.
# Host already runs Postgres:5432 + Redis:6379, so the containers are remapped to
# 5433 / 6380. Keep these in sync with the repo-root .env.
POSTGRES_USER=teranode
POSTGRES_PASSWORD=teranode
POSTGRES_DB=teranode
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# (the app processes read these from the repo-root .env / apps/*/.env)
DATABASE_URL=postgres://teranode:teranode@localhost:5433/teranode
REDIS_URL=redis://localhost:6380
MQTT_URL=mqtt://localhost:1883
