# ── TERANODE root env (copy to .env) ────────────────────────────────────────
# Postgres / TimescaleDB
DATABASE_URL=postgres://teranode:teranode@localhost:5432/teranode
POSTGRES_USER=teranode
POSTGRES_PASSWORD=teranode
POSTGRES_DB=teranode

# Redis
REDIS_URL=redis://localhost:6379

# MQTT (Mosquitto)
MQTT_URL=mqtt://localhost:1883

# API
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:8081,http://localhost:19006
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Virtual gateway (hardware-free demo)
VIRTUAL_GATEWAY=true
SIM_TICK_MS=2000

# SMTP (dev: Mailpit on localhost:1025; web UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=TERANODE <no-reply@teranode.local>
APP_LOGIN_URL=http://localhost:5173

# Auth hardening
CSRF_SECRET=dev-csrf-secret-change-me
COOKIE_SECURE=false
